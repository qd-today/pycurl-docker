     insint_c(d, "SSL_SIGNATURE_ALGORITHMS", CURLOPT_SSL_SIGNATURE_ALGORITHMS);
 #endif
+    /* curl-impersonate: see the note in src/easyopt.c -- enum constant, no #ifdef */
