# syntax=docker/dockerfile:1.7
#
# pycurl（含 IMPERSONATE）：curl-impersonate superbuild + BoringSSL
#
# 三个出口与 Dockerfile 同构：
#   build   编译 curl-impersonate / BoringSSL 与打补丁的 pycurl，产出 /wheels
#   wheel   FROM scratch，只有 /wheels
#   runtime 只从 wheelhouse 装 pycurl
#
# 这条线同时供给 ja3-latest 与 ja3-lite-latest 两个 tag（同一个 manifest）。
#
# curl-impersonate 固定到 commit：上游已删除 v2.4.0 标签（2026-10-25），按 tag 会拉不到。
# 该 commit 是 curl 8.23.0 代码线，含 chrome151/152、safari27、firefox153-155 指纹
# （ECH / ZSTD / PQC / HTTP/3），QUIC 后端为 ngtcp2 + BoringSSL，依赖按上游 pinned 版本静态编译。
ARG ALPINE_VERSION=3.24
ARG BASE_IMAGE=alpine:${ALPINE_VERSION}

########################################################################
# 构建
########################################################################
FROM ${BASE_IMAGE} AS build

ARG APK_MIRROR=""
ARG PIP_MIRROR=""
ARG GIT_DOMAIN="https://github.com"
ARG TARGETARCH
ARG TARGETVARIANT
ARG PYCURL_VERSION=7.49.0
ARG CURL_IMPERSONATE_REF=df38987ca6214c404700b320f853243d9ddb4a06
ARG AUDITWHEEL_VERSION=6.8.2

LABEL maintainer="a76yyyy <q981331502@163.com>"
LABEL org.opencontainers.image.source=https://github.com/qd-today/pycurl-docker

# pycurl 编译期 SSL 后端声明（BoringSSL 与 OpenSSL API 兼容）；
# curl-config 指向 impersonate 版：pip 解析 sdist 元数据与编译都会读它
ENV PYCURL_SSL_LIBRARY=openssl
ENV PYCURL_CURL_CONFIG=/usr/bin/curl-impersonate-config

RUN if [ -n "${APK_MIRROR}" ]; then \
        sed -i "s|https://dl-cdn.alpinelinux.org|${APK_MIRROR%/}|g" /etc/apk/repositories; \
    fi \
 && cat /etc/apk/repositories

RUN apk add --no-cache \
        cmake ninja make musl-dev perl autoconf automake libtool pkgconf \
        g++ linux-headers bzip2 xz-libs xz-dev unzip zip curl patch \
        git python3 python3-dev py3-pip py3-setuptools py3-wheel \
        patchelf

RUN set -eux; \
    if [ -n "${PIP_MIRROR}" ]; then pip_args="-i ${PIP_MIRROR}"; else pip_args=""; fi; \
    python3 -m pip install --no-cache-dir --break-system-packages \
        ${pip_args} "auditwheel==${AUDITWHEEL_VERSION}"; \
    python3 -m auditwheel --version

# armv6 无 NEON，BoringSSL 的汇编不可用，需关掉（不影响 TLS 指纹）
RUN set -eux; \
    git init -q /curl-impersonate; \
    cd /curl-impersonate; \
    git remote add origin ${GIT_DOMAIN}/lexiforest/curl-impersonate; \
    git fetch --depth 1 origin ${CURL_IMPERSONATE_REF}; \
    git checkout -q FETCH_HEAD; \
    ASM_FLAG="-DDISABLE_BORINGSSL_ASM=OFF"; \
    if [ "${TARGETARCH}" = "arm" ] && [ "${TARGETVARIANT}" = "v6" ]; then \
        ASM_FLAG="-DDISABLE_BORINGSSL_ASM=ON"; \
    fi; \
    CMAKE_ARGS="-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib ${ASM_FLAG} \
        -DCURL_CA_PATH=/etc/ssl/certs -DCURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"; \
    make prepare-libidn2 BUILD_DIR=build JOBS="$(nproc)"; \
    make build BUILD_DIR=build JOBS="$(nproc)" CMAKE_CONFIGURE_ARGS="${CMAKE_ARGS}"; \
    make checkbuild BUILD_DIR=build; \
    make install-strip BUILD_DIR=build JOBS="$(nproc)" CMAKE_CONFIGURE_ARGS="${CMAKE_ARGS}"

# CURLOPT_IMPERSONATE（选项 10999）不在 pycurl 的 setopt 类型表与常量表里，补丁补上后
# 可直接 c.setopt(pycurl.IMPERSONATE, "chrome152")，同时清掉 pycurl 构造时强设的默认 UA
COPY patches/pycurl-impersonate.patch /tmp/pycurl-impersonate.patch

# pycurl 官方 sdist（含构建期生成的 src/docstrings.c，GitHub tag tarball 没有）
RUN set -eux; \
    if [ -n "${PIP_MIRROR}" ]; then pip_args="-i ${PIP_MIRROR}"; else pip_args=""; fi; \
    python3 -m pip download --no-cache-dir --no-deps --no-binary :all: ${pip_args} \
        -d /tmp/pycurl-dl "pycurl==${PYCURL_VERSION}"; \
    tar xzf "/tmp/pycurl-dl/pycurl-${PYCURL_VERSION}.tar.gz" -C /tmp; \
    mv "/tmp/pycurl-${PYCURL_VERSION}" /tmp/pycurl; \
    patch -d /tmp/pycurl -p1 < /tmp/pycurl-impersonate.patch; \
    rm -rf /tmp/pycurl-dl /tmp/pycurl-impersonate.patch

COPY src/pack_wheel.py /usr/local/bin/pack_wheel.py

# openssl-dir 仅编译期需要，指向 superbuild 的依赖 staging 目录（BoringSSL 头文件与静态库）
RUN set -eux; \
    PYCURL_OPENSSL_DIR=/curl-impersonate/build/deps/install \
    python3 -m pip wheel --no-cache-dir --no-build-isolation --no-deps \
        --wheel-dir /raw /tmp/pycurl; \
    rm -rf /tmp/pycurl /curl-impersonate; \
    python3 /usr/local/bin/pack_wheel.py \
        --wheel-dir /raw \
        --out-dir /wheels \
        --expect-version "${PYCURL_VERSION}" \
        --require-lib 'libcurl*.so.4*' \
        --require-lib 'libstdc++*.so.6*'

COPY system-packages.txt /wheels/system-packages.txt

# 把 curl 命令行收进 /opt/curl-cli：二进制 + 它实际链接的库。
# 用 ldd 结果收集而不是手写库名：库的集合随编译配置变（HTTP/3 后端、TLS 实现），
# 手写清单迟早会漏一个，报错还表现在运行期。
RUN set -eux; \
    mkdir -p /opt/curl-cli; \
    cp /usr/bin/curl-impersonate /opt/curl-cli/curl; \
    ldd /usr/bin/curl-impersonate 2>/dev/null \
        | sed -n 's/.*=> \(\/[^ ]*\).*/\1/p; s/^\s*\(\/[^ ]*\) (0x[0-9a-f]*).*/\1/p' \
        | sort -u \
        | while read -r lib; do cp -L "$lib" /opt/curl-cli/ 2>/dev/null || true; done; \
    ls -1 /opt/curl-cli


RUN set -eux; \
    python3 /usr/local/bin/pack_wheel.py --emit-index --out-dir /wheels; \
    cd /wheels; \
    sha256sum ./*.whl > SHA256SUMS; \
    ls -l; \
    cat SHA256SUMS; \
    python3 -m pip install --no-cache-dir --break-system-packages \
        --no-index --find-links /wheels "pycurl==${PYCURL_VERSION}"; \
    python3 -c "import pycurl; assert pycurl.IMPERSONATE == 10999, 'IMPERSONATE patch not applied'"; \
    python3 -c "import pycurl; assert pycurl.version_info()[4] & pycurl.CURL_VERSION_HTTP3"

########################################################################
# wheelhouse 出口
########################################################################
FROM scratch AS wheel

COPY --from=build /wheels/ /wheels/

########################################################################
# 编译产物（两段式构建的第一段导出物）
#
# 除 wheel 外还带上 curl 命令行二进制：runtime 阶段要用它，不然 runtime 只能回头
# 依赖 build stage，跨 runner 就断了。
#
#   docker buildx build --target artifacts --output type=local,dest=dist .
########################################################################
FROM scratch AS artifacts

COPY --from=build /wheels/ /wheels/
COPY --from=build /opt/curl-cli/ /opt/curl-cli/

########################################################################
# 外部产物注入点（--build-context wheelsrc=<dist>）
########################################################################
FROM scratch AS wheelsrc

########################################################################
# 从产物构造 wheelhouse 镜像（两段式的第二段，不需要重新编译）
########################################################################
FROM scratch AS wheel-from-artifacts

COPY --from=wheelsrc /wheels /wheels

########################################################################
# 运行时出口
########################################################################
FROM ${BASE_IMAGE} AS runtime

# Docker 自动提供的目标平台参数。不能用 uname -m 判断：buildkit 的 RUN 里 uname 返回的
# 是构建环境的内核架构（armv6 构建实测返回 aarch64），不是 --platform 指定的那个。
ARG TARGETARCH
ARG TARGETVARIANT
ARG PYCURL_VERSION=7.49.0
ARG APK_MIRROR=""
ARG PIP_MIRROR=""

LABEL maintainer="a76yyyy <q981331502@163.com>"
LABEL org.opencontainers.image.source=https://github.com/qd-today/pycurl-docker

RUN if [ -n "${APK_MIRROR}" ]; then \
        sed -i "s|https://dl-cdn.alpinelinux.org|${APK_MIRROR%/}|g" /etc/apk/repositories; \
    fi \
 && cat /etc/apk/repositories

RUN --mount=type=bind,from=wheelsrc,source=wheels,target=/w \
    apk add --no-cache $(cat /w/system-packages.txt) uv

# 统一用 uv：runtime 组装在 x86_64 上跑（见 wheelsrc 那段说明），QEMU 模拟 armv6 时
# Python 报 linux-armv7l，与 wheel 的 musllinux_1_2_armv7l 匹配，uv 装 1-2 秒完成。
# 之前 armv6 之所以要退回 pip，是因为它和 arm64/armv7 挤在同一个 arm64 runner 上，
# 那里 Python 报 linux-aarch64，uv 会挂死（probe 实测：x86_64 两版 uv 都通过，
# arm64 runner 上两版都超时，pip 能过）。拆开后不需要这个特例了。
#
# 架构分支一律用 TARGETARCH/TARGETVARIANT：uname -m 在 buildkit 的 RUN 里拿到的是构建
# 环境的内核架构（armv6 构建实测返回 aarch64），不看 uname。
# 注释必须写在 RUN 之前：Docker 把续行拼成一行，行内 # 会把后面的命令整段注释掉。
RUN --mount=type=bind,from=wheelsrc,source=wheels,target=/w \
    set -eux; \
    uv pip install --system --break-system-packages --no-cache --no-compile-bytecode \
        --index-url "${PIP_MIRROR:-https://pypi.org/simple}" \
        --extra-index-url file:///w/simple \
        "pycurl==${PYCURL_VERSION}"; \
    uv pip check --system; \
    python3 -c "import pycurl; print(pycurl.version)"


# curl 命令行：二进制与它的私有库放在一起，用包装脚本限定 LD_LIBRARY_PATH 的作用域，
# 免得污染镜像里其他进程的库解析。
# --chmod 是必须的：--output type=local 导出产物时会丢可执行位，再通过
# --build-context 拷回来就没有执行权限了（冒烟时报 "can't execute: Permission denied"）。
# 目录里还有 curl 的私有 .so，一并给 755 无害。
COPY --chmod=0755 --from=wheelsrc /opt/curl-cli /opt/curl-cli
RUN set -eux; \
    printf '#!/bin/sh\nexec env LD_LIBRARY_PATH=/opt/curl-cli /opt/curl-cli/curl "$@"\n' \
        > /usr/local/bin/curl; \
    chmod +x /usr/local/bin/curl; \
    curl --version | head -1

CMD ["python3", "-c", "import pycurl; print(pycurl.version)"]
